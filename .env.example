# Copy to .env and fill in. .env is git-ignored; never commit or paste these.
# Gemini API key from https://aistudio.google.com/apikey (image models need billing or prepaid credit)
GEMINI_API_KEY=
# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Optional: your own Telegram user id (pack owner), find it with: python -m sticker_booth.telegram_pack --whoami
# TELEGRAM_USER_ID=
